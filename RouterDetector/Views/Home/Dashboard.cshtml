@model RouterDetector.Models.DashboardViewModel
@{
    ViewData["Title"] = "Threat Detection & Monitoring Dashboard";
    string GetSeverityBadgeClass(string severity)
    {
        return severity?.ToLower() switch
        {
            "high" => "badge bg-danger",
            "medium" => "badge bg-warning text-dark",
            "low" => "badge bg-success",
            "critical" => "badge bg-dark",
            _ => "badge bg-secondary"
        };
    }
}
@using System.Linq;
@using System;
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Chart.js configurations and data
        const chartColors = [
            '#007bff', '#dc3545', '#ffc107', '#17a2b8', '#28a745', '#343a40', '#6c757d',
            '#6610f2', '#fd7e14', '#20c997', '#6f42c1', '#e83e8c', '#adb5bd', '#f8f9fa'
        ];
        // Attack Type Chart
        const attackTypeData = {
            labels: @Json.Serialize(Model.AttackTypeCounts.Keys),
            datasets: [{
                label: 'Attack Count',
                data: @Json.Serialize(Model.AttackTypeCounts.Values),
                backgroundColor: chartColors.slice(0, Object.keys(@Json.Serialize(Model.AttackTypeCounts)).length),
                borderWidth: 2
            }]
        };
        // Severity Distribution Chart
        const severityData = {
            labels: @Json.Serialize(Model.EventsBySeverity.Keys),
            datasets: [{
                label: 'Events by Severity',
                data: @Json.Serialize(Model.EventsBySeverity.Values),
                backgroundColor: chartColors.slice(1, 5),
                borderWidth: 2
            }]
        };
        // Event Type Bar Chart (total counts)
        const eventTypeLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.EventsByType.Keys.ToList()));
        const eventTypeData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.EventsByType.Values.Select(x => Convert.ToInt32(x)).ToList()));
        // Hourly Activity Chart
        const hourlyLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.EventsByHour.Keys.ToList()));
        const hourlyDataArr = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.EventsByHour.Values.Select(x => Convert.ToInt32(x)).ToList()));
        // Debug output
        console.log('eventTypeLabels:', eventTypeLabels);
        console.log('eventTypeData:', eventTypeData);
        console.log('hourlyLabels:', hourlyLabels);
        console.log('hourlyDataArr:', hourlyDataArr);
        const eventTypeBarData = {
            labels: eventTypeLabels,
            datasets: [{
                label: 'Event Count',
                data: eventTypeData,
                backgroundColor: chartColors.slice(0, eventTypeLabels.length),
                borderWidth: 1
            }]
        };
        const hourlyData = {
            labels: hourlyLabels,
            datasets: [{
                label: 'Events by Hour',
                data: hourlyDataArr,
                borderColor: chartColors[3],
                backgroundColor: 'rgba(23, 162, 184, 0.1)',
                tension: 0.4,
                fill: true
            }]
        };
        // Initialize charts when page loads
        document.addEventListener('DOMContentLoaded', function() {
            // Attack Type Chart
            if (attackTypeData.labels.length && attackTypeData.datasets[0].data.length) {
                if (document.getElementById('attackTypeChart')) {
                    new Chart(document.getElementById('attackTypeChart'), {
                        type: 'doughnut',
                        data: attackTypeData,
                        options: {
                            responsive: true,
                            plugins: {
                                legend: { position: 'bottom' },
                                title: { display: true, text: 'Attack Type Distribution' }
                            }
                        }
                    });
                }
            }
            // Severity Distribution Chart
            if (severityData.labels.length && severityData.datasets[0].data.length) {
                if (document.getElementById('severityChart')) {
                    new Chart(document.getElementById('severityChart'), {
                        type: 'pie',
                        data: severityData,
                        options: {
                            responsive: true,
                            plugins: {
                                legend: { position: 'bottom' },
                                title: { display: true, text: 'Events by Severity' }
                            }
                        }
                    });
                }
            }
            // Event Type Bar Chart
            if (eventTypeLabels.length && eventTypeData.length) {
                if (document.getElementById('eventTypeBarChart')) {
                    new Chart(document.getElementById('eventTypeBarChart'), {
                        type: 'bar',
                        data: eventTypeBarData,
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                title: { display: true, text: 'Event Types (Total Counts)' }
                            },
                            scales: { y: { beginAtZero: true } }
                        }
                    });
                }
            }
            // Hourly Activity Chart
            if (hourlyLabels.length && hourlyDataArr.length) {
                if (document.getElementById('hourlyChart')) {
                    new Chart(document.getElementById('hourlyChart'), {
                        type: 'line',
                        data: hourlyData,
                        options: {
                            responsive: true,
                            plugins: {
                                legend: { display: false },
                                title: { display: true, text: 'Hourly Activity Pattern' }
                            },
                            scales: { y: { beginAtZero: true } }
                        }
                    });
                }
            }
        });

        // Filter form submission
        function applyFilters() {
            const form = document.getElementById('filterForm');
            const formData = new FormData(form);
            const params = new URLSearchParams();
            
            for (let [key, value] of formData.entries()) {
                if (value) params.append(key, value);
            }
            
            window.location.href = '/Home/Dashboard?' + params.toString();
        }

        function clearFilters() {
            window.location.href = '/Home/Dashboard';
        }
    </script>
}

<div class="container-fluid" style="padding-bottom: 80px;">
    <div class="row">
        <div class="col-lg-9">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Security Analytics Dashboard</h1>
            <p class="text-muted mb-0">Comprehensive threat monitoring and network analysis</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            @if (ViewBag.UserSacco != null)
            {
                <div class="me-3">
                    <div class="text-end">
                        <div class="fw-bold text-primary" style="font-size: 1.2rem;">
                            <i class="fas fa-building me-2"></i>
                            @ViewBag.UserSacco.InstitutionName
                        </div>
                        <div class="text-muted" style="font-size: 1rem;">
                            @ViewBag.UserSacco.County
                        </div>
                    </div>
                </div>
            }
            <button class="btn btn-outline-primary" onclick="window.print()">
                <i class="fas fa-print me-1"></i>Export Report
            </button>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-filter me-2"></i>Filter Analytics</h5>
        </div>
        <div class="card-body">
            <form id="filterForm" class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">Start Date</label>
                    <input type="date" class="form-control" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-2">
                    <label class="form-label">End Date</label>
                    <input type="date" class="form-control" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Event Type</label>
                    <select class="form-select" name="eventType">
                        <option value="">All Types</option>
                        @foreach (var eventType in ViewBag.EventTypes as List<string>)
                        {
                            if (Model.SelectedEventType == eventType)
                            {
                                <option value="@eventType" selected>@eventType</option>
                            }
                            else
                            {
                                <option value="@eventType">@eventType</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Severity</label>
                    <select class="form-select" name="severity">
                        <option value="">All Severities</option>
                        @foreach (var severity in ViewBag.Severities as List<string>)
                        {
                            if (Model.SelectedSeverity == severity)
                            {
                                <option value="@severity" selected>@severity</option>
                            }
                            else
                            {
                                <option value="@severity">@severity</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Rule Type</label>
                    <select class="form-select" name="ruleType">
                        <option value="">All Rules</option>
                        @foreach (var ruleType in ViewBag.RuleTypes as List<string>)
                        {
                            if (Model.SelectedRuleType == ruleType)
                            {
                                <option value="@ruleType" selected>@ruleType</option>
                            }
                            else
                            {
                                <option value="@ruleType">@ruleType</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Action Taken</label>
                    <select class="form-select" name="actionTaken">
                        <option value="">All Actions</option>
                        @foreach (var action in ViewBag.ActionTakens as List<string>)
                        {
                            if (Model.SelectedActionTaken == action)
                            {
                                <option value="@action" selected>@action</option>
                            }
                            else
                            {
                                <option value="@action">@action</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-12">
                    <button type="button" class="btn btn-primary" onclick="applyFilters()">
                        <i class="fas fa-search me-1"></i>Apply Filters
                    </button>
                    <button type="button" class="btn btn-outline-secondary" onclick="clearFilters()">
                        <i class="fas fa-times me-1"></i>Clear Filters
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Key Metrics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                    <h4 class="mb-1">@Model.TotalEventLogs</h4>
                            <p class="mb-0">Total Events</p>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-shield-alt fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-danger text-white h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-1">@Model.TotalThreats</h4>
                            <p class="mb-0">High/Critical Threats</p>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-exclamation-triangle fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-dark h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-1">@Model.TotalBlocked</h4>
                            <p class="mb-0">Blocked Attacks</p>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-ban fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-1">@Model.TotalQuarantined</h4>
                            <p class="mb-0">Quarantined</p>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-box fa-2x opacity-75"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Attack Type Cards Row -->
    <div class="row">
        <div class="col-xl-2 col-md-4">
            <div class="card bg-info text-white mb-4">
                <div class="card-body">
                    <h4>@Model.BruteForceDetections.Count</h4>
                    <p>Brute Force Attacks</p>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4">
            <div class="card bg-danger text-white mb-4">
                <div class="card-body">
                    <h4>@Model.DdosDetections.Count</h4>
                    <p>DDoS Attacks</p>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4">
            <div class="card bg-warning text-dark mb-4">
                <div class="card-body">
                    <h4>@Model.PortScanDetections.Count</h4>
                    <p>Port Scan Attacks</p>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body">
                    <h4>@Model.WebAppAttackDetections.Count</h4>
                    <p>Web App Attacks</p>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4">
            <div class="card bg-success text-white mb-4">
                <div class="card-body">
                    <h4>@Model.MalwareEvents.Count</h4>
                    <p>Malware Events</p>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4">
            <div class="card bg-secondary text-white mb-4">
                <div class="card-body">
                    <h4>@Model.PhishingEvents.Count</h4>
                    <p>Phishing Events</p>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4">
            <div class="card bg-dark text-white mb-4">
                <div class="card-body">
                    <h4>@Model.SuspiciousEmailEvents.Count</h4>
                    <p>Suspicious Email Events</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Attack Type and Severity Charts Row -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-chart-pie me-2"></i>Attack Type Distribution</h5>
                </div>
                <div class="card-body">
                    @if (Model.AttackTypeCounts == null || !Model.AttackTypeCounts.Any())
                    {
                        <div class="text-center text-muted">No attack type data available.</div>
                    }
                    else
                    {
                        <canvas id="attackTypeChart" height="300"></canvas>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-chart-pie me-2"></i>Events by Severity</h5>
                </div>
                <div class="card-body">
                    @if (Model.EventsBySeverity == null || !Model.EventsBySeverity.Any())
                    {
                        <div class="text-center text-muted">No severity data available.</div>
                    }
                    else
                    {
                        <canvas id="severityChart" height="300"></canvas>
                    }
                </div>
            </div>
        </div>
    </div>
    <!-- Event Types and Hourly Activity Charts Row -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Event Types (Total Counts)</h5>
                </div>
                <div class="card-body" style="min-height:320px;">
                    @if (Model.EventsByType == null || !Model.EventsByType.Any())
                    {
                        <div class="text-center text-muted">No event type data available.</div>
                    }
                    else
                    {
                        <canvas id="eventTypeBarChart" height="300"></canvas>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-clock me-2"></i>Hourly Activity Pattern</h5>
                </div>
                <div class="card-body" style="min-height:320px;">
                    @if (Model.EventsByHour == null || !Model.EventsByHour.Any())
                    {
                        <div class="text-center text-muted">No hourly data available.</div>
                    }
                    else
                    {
                        <canvas id="hourlyChart" height="300"></canvas>
                    }
                </div>
            </div>
        </div>
    </div>
    <!-- Top Source IPs Table -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-list me-2"></i>Top Source IPs</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>IP Address</th>
                                    <th>Event Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ip in Model.TopSourceIPs.Take(10))
                                {
                                    <tr>
                                        <td><code>@ip.Key</code></td>
                                        <td><span class="badge bg-primary">@ip.Value</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Events Table -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-history me-2"></i>Recent Security Events</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Timestamp</th>
                            <th>Event Type</th>
                            <th>Rule Type</th>
                            <th>Source IP</th>
                            <th>Severity</th>
                            <th>Action Taken</th>
                            <th>Message</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.RecentEvents)
                        {
                            <tr>
                                <td>@item.Timestamp.ToString("g")</td>
                                <td><span class="badge bg-info">@item.EventType</span></td>
                                <td><span class="badge bg-secondary">@item.RuleType</span></td>
                                <td><code>@item.SrcIp</code></td>
                                <td><span class="@GetSeverityBadgeClass(item.Severity)">@item.Severity</span></td>
                                <td><span class="badge bg-warning text-dark">@item.ActionTaken</span></td>
                                <td>@item.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
            </div>
        <div class="col-lg-3">
            @if (ViewBag.IsAdmin == true)
            {
                <div class="card mb-4" style="max-height: 70vh; overflow-y: auto;">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <span>Saccos by County</span>
                        <button id="resetSaccoFilter" class="btn btn-sm btn-outline-secondary ms-2" style="display:none;" onclick="resetSaccoSearch()">Reset</button>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.SelectedSaccoId != null)
                        {
                            <div class="p-2">
                                <a href="@Url.Action("Dashboard", "Home")" class="btn btn-outline-primary w-100 mb-2"><i class="fa fa-times me-1"></i>Show All Saccos</a>
                            </div>
                        }
                        <div class="p-2">
                            <input type="text" id="saccoSearch" class="form-control form-control-sm" placeholder="Search Saccos..." oninput="filterSaccos()" />
                        </div>
                        <div id="saccoSidebarList">
                            @foreach (var countyGroup in Model.Saccos.GroupBy(s => s.County).OrderBy(g => g.Key))
                            {
                                <div class="fw-bold mt-2 px-3 county-label">@countyGroup.Key</div>
                                <ul class="list-group list-group-flush mb-2">
                                    @foreach (var sacco in countyGroup.OrderBy(s => s.InstitutionName))
                                    {
                                        <li class="list-group-item py-1 px-3 sacco-item @(Model.SelectedSaccoId == sacco.Id ? "active bg-primary text-white" : "")" data-county="@countyGroup.Key" data-name="@sacco.InstitutionName.ToLower()" style="cursor:pointer;">
                                            <a href="@Url.Action("Dashboard", "Home", new { saccoId = sacco.Id })" style="color:inherit;text-decoration:none;display:block;">
                                                <span class="text-truncate d-inline-block" style="max-width: 180px;">@sacco.InstitutionName</span>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
                <a href="@Url.Action("Index", "Setups")" class="btn btn-warning w-100 mb-3">Manage Setups</a>
            }
        </div>
        <script>
            function filterSaccos() {
                var input = document.getElementById('saccoSearch');
                var filter = input.value.toLowerCase();
                var sidebar = document.getElementById('saccoSidebarList');
                var items = sidebar.querySelectorAll('.sacco-item');
                var counties = sidebar.querySelectorAll('.county-label');
                let anyVisible = false;
                items.forEach(function(item) {
                    var name = item.getAttribute('data-name');
                    if (!filter || name.includes(filter)) {
                        item.style.display = '';
                        anyVisible = true;
                    } else {
                        item.style.display = 'none';
                    }
                });
                counties.forEach(function(county) {
                    var next = county.nextElementSibling;
                    var hasVisible = false;
                    if (next && next.tagName === 'UL') {
                        var lis = next.querySelectorAll('.sacco-item');
                        lis.forEach(function(li) {
                            if (li.style.display !== 'none') hasVisible = true;
                        });
                    }
                    county.style.display = hasVisible ? '' : 'none';
                });
                document.getElementById('resetSaccoFilter').style.display = filter ? '' : 'none';
            }
            function resetSaccoSearch() {
                document.getElementById('saccoSearch').value = '';
                filterSaccos();
            }
        </script>
    </div>
</div>