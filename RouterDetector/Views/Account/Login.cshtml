@{
    ViewData["Title"] = "Login";
    Layout = null; // Remove layout to hide nav
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/site.css" />
    <title>Login - Web-Based Threat Detection and Monitoring System</title>
    <style>
        body {
            background: linear-gradient(135deg, #007bff 0%, #6a11cb 100%);
        }
        .login-card {
            border-radius: 1rem;
            box-shadow: 0 4px 24px rgba(0,0,0,0.15);
            background: #fff;
        }
        .login-logo {
            font-size: 3rem;
            color: #007bff;
        }
        .footer-text {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            color: rgba(255, 255, 255, 0.8);
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <div class="container d-flex align-items-center justify-content-center" style="min-height: 100vh;">
        <div class="login-card card p-4 w-100" style="max-width: 400px;">
            <div class="text-center mb-3">
                <span class="login-logo"><i class="fa-solid fa-shield-virus"></i></span>
            </div>
            <h2 class="text-center mb-4">Login</h2>
            <form asp-action="Login" method="post" id="loginForm">
                <div class="form-group mb-3">
                    <label for="username">Username or Email</label>
                    <input type="text" class="form-control" id="username" name="username" required />
                    <small class="form-text text-muted">Use your username (not your role/position) to login</small>
                </div>
                <div class="form-group mb-3">
                    <label for="password">Password</label>
                    <input type="password" class="form-control" id="password" name="password" required />
                </div>
                <button type="submit" class="btn btn-primary w-100">Login</button>
            </form>
            <div class="text-danger mt-3">
                @if (ViewBag.Error != null)
                {
                    <div>@ViewBag.Error</div>
                }
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
            
            <!-- CTI Information -->
            <div class="text-center mt-4">
                <div class="border-top pt-3">
                    <h6 class="text-muted mb-2">CTI</h6>
                    <p class="small text-muted mb-0">
                        <strong>Cyber Threat Intelligence</strong><br>
                        Advanced network security monitoring and threat detection system
                    </p>
                </div>
            </div>
            
            @* Registration and forgot password links commented out as requested
            <div class="text-center mt-3">
                <a href="/Account/ForgotPassword">Forgot password?</a>
            </div>
            <p class="mt-3 text-center">Don't have an account? <a asp-action="Register">Register here</a>.</p>
            *@
        </div>
    </div>
    <div class="footer-text">
        CTI - Web-Based Threat Detection and Monitoring System
    </div>
    <script src="https://kit.fontawesome.com/6e0e4b8b7b.js" crossorigin="anonymous"></script>
    <script>
        // Login form is now simplified - no Sacco selection needed
        // Users will see their Sacco information on the dashboard
    </script>
</body>
</html> 