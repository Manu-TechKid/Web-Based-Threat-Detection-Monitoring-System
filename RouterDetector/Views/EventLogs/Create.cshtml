@model RouterDetector.Models.EventLog
@{
    ViewData["Title"] = "Create Event Log";
}
<h1>Create Event Log</h1>
<form asp-action="Create" method="post">
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Timestamp" class="form-label"></label>
                <input asp-for="Timestamp" class="form-control" type="datetime-local" />
                <span asp-validation-for="Timestamp" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Institution" class="form-label"></label>
                <input asp-for="Institution" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="DeviceName" class="form-label"></label>
                <input asp-for="DeviceName" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="DeviceType" class="form-label"></label>
                <input asp-for="DeviceType" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="LogSource" class="form-label"></label>
                <input asp-for="LogSource" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="EventType" class="form-label"></label>
                <select asp-for="EventType" class="form-select">
                    <option value="">-- Select Event Type --</option>
                    @foreach (var item in ViewBag.EventTypes as List<string>)
                    {
                        <option value="@item">@item</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Severity" class="form-label"></label>
                <select asp-for="Severity" class="form-select">
                    <option value="">-- Select Severity --</option>
                    @foreach (var item in ViewBag.Severities as List<string>)
                    {
                        <option value="@item">@item</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="SrcIp" class="form-label"></label>
                <input asp-for="SrcIp" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="DstIp" class="form-label"></label>
                <input asp-for="DstIp" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="SrcPort" class="form-label"></label>
                <input asp-for="SrcPort" class="form-control" type="number" />
            </div>
            <div class="mb-3">
                <label asp-for="DstPort" class="form-label"></label>
                <input asp-for="DstPort" class="form-control" type="number" />
            </div>
            <div class="mb-3">
                <label asp-for="Protocol" class="form-label"></label>
                <input asp-for="Protocol" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="ActionTaken" class="form-label"></label>
                <select asp-for="ActionTaken" class="form-select">
                    <option value="">-- Select Action Taken --</option>
                    @foreach (var item in ViewBag.ActionTakens as List<string>)
                    {
                        <option value="@item">@item</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="NatSrcIp" class="form-label"></label>
                <input asp-for="NatSrcIp" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="NatDstIp" class="form-label"></label>
                <input asp-for="NatDstIp" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Hostname" class="form-label"></label>
                <input asp-for="Hostname" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Notes" class="form-label"></label>
                <input asp-for="Notes" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="RuleType" class="form-label"></label>
                <select asp-for="RuleType" class="form-select">
                    <option value="">-- Select Rule Type --</option>
                    @foreach (var item in ViewBag.RuleTypes as List<string>)
                    {
                        <option value="@item">@item</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="LivePcap" class="form-label"></label>
                <input asp-for="LivePcap" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Message" class="form-label"></label>
                <select asp-for="Message" class="form-select">
                    <option value="">-- Select Message --</option>
                    @foreach (var item in ViewBag.Messages as List<string>)
                    {
                        <option value="@item">@item</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="LogOccurrence" class="form-label"></label>
                <input asp-for="LogOccurrence" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="EventType2" class="form-label"></label>
                <input asp-for="EventType2" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Severity2" class="form-label"></label>
                <input asp-for="Severity2" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="UserAccount" class="form-label"></label>
                <input asp-for="UserAccount" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="ActionTaken2" class="form-label"></label>
                <input asp-for="ActionTaken2" class="form-control" />
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 