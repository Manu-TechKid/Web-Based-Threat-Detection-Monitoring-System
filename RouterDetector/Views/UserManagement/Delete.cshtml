@model RouterDetector.Models.User
@{
    ViewBag.Title = "Delete User";
}
<div class="container mt-4">
    <h2>Delete User</h2>
    <div class="alert alert-warning">
        <strong>Are you sure you want to delete this user?</strong>
        <br />
        This action cannot be undone.
    </div>
    <dl class="row">
        <dt class="col-sm-2">Username</dt>
        <dd class="col-sm-10">@Model.Username</dd>
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>
        <dt class="col-sm-2">Staff Position</dt>
        <dd class="col-sm-10">@Model.StaffPosition</dd>
        <dt class="col-sm-2">Sacco</dt>
        <dd class="col-sm-10">@Model.Sacco?.InstitutionName</dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div> 